# MySQL connection (used by app/db/database.py)
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_contrasena
DB_NAME=sentinel

# Key used to sign the login sessions (use a long random string)
SECRET_KEY=cambia_esta_clave

# Folder for uploaded files (optional; default: "attachments" in the project root).
# In production use a path outside the code, owned by the web server user.
# ATTACHMENTS_DIR=/var/lib/sentinel/attachments
